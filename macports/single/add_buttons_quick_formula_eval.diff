+//******************************************************
 /*
+ * Use buttons to set quick arithmetic formulas
+ */
+static void set_quick_formula(Widget w, XtPointer client_data, XtPointer call_data)
+{
+    char fstr[256];
+    set_wait_cursor();
+    int type = (intptr_t) client_data;
+
+    if (type == 1) {
+        strcat(strcpy(fstr,"y=y+"),GetTextString(amount_text_add_sub));
+    } else if (type == 2) {
+        strcat(strcpy(fstr,"y=y-"),GetTextString(amount_text_add_sub));
+    } else if (type == 3) {
+        strcat(strcpy(fstr,"y=y*"),GetTextString(amount_text_mul_div));
+    } else if (type == 4) {
+        strcat(strcpy(fstr,"y=y/"),GetTextString(amount_text_mul_div));
+    } else {
+        errmsg("Missing formula");
+    }
+
+    XmTextSetString(eui.formula_item, fstr);
+
+    unset_wait_cursor();
+}
